<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    The HTTP cache is redirected into the workspace. NuGet defaults to a location
    under the user profile, which is outside the tree this repository is allowed to
    write to; leaving it there turns a restore into a permission error that is
    reported as NU1900 and, with warnings as errors, fails the build.
  -->
  <config>
    <add key="httpCachePath" value="artifacts/nuget-http-cache" />
    <add key="globalPackagesFolder" value="artifacts/nuget-packages" />
  </config>

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

</configuration>
