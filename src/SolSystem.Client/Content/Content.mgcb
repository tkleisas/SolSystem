# The MonoGame content pipeline, for the two things that cannot be done without a shader:
# the Sun's disc and corona, and the specular finish on an Illuminus hull.

/outputDir:bin/$(Platform)
/intermediateDir:obj/$(Platform)
/platform:DesktopGL
/config:
/profile:Reach
/compress:False

#begin Hud.spritefont
/importer:FontDescriptionImporter
/processor:FontDescriptionProcessor
/processorParam:PremultiplyAlpha=True
/processorParam:TextureFormat=Compressed
/build:Hud.spritefont

#begin Sun.mgfx
# Compiled ahead of this build by the CompileEffects target (ShadowDuskCLI — no Wine, no
# Windows SDK). The pipeline's only job with the file is to copy it where the XNB used to be;
# the client reads it as a file, so there is no XNB wrapper in the path.
/copy:Sun.mgfx
