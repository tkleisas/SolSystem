<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SolSystem.Client</RootNamespace>
    <AssemblyName>SolSystem.Client</AssemblyName>
    <!-- MonoGame's content pipeline and the DesktopGL runtime are the two places a warning
         becomes noise rather than signal, and this project treats warnings as errors. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>

    <!-- The content pipeline is driven by the mgcb dotnet tool, which is pinned in
         /.config/dotnet-tools.json. Restoring it as part of the build means a fresh clone works with
         `dotnet build` and nothing else — without this it fails with "dotnet-mgcb does not exist",
         which names the symptom and not the cure. -->
    <AutoRestoreMGCBTool>true</AutoRestoreMGCBTool>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5.1" />

    <!-- Runs mgcb over Content/Content.mgcb during the build, so a shader is compiled as part of
         the project rather than by a step somebody has to remember. -->
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.5.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Content/Content.mgcb" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SolSystem.Core/SolSystem.Core.csproj" />
  </ItemGroup>

  <!--
    The effect compiles ahead of the content build with ShadowDuskCLI — HLSL through DXC
    and SPIRV-Cross straight to GLSL, every native binary shipped for every desktop
    platform — so the shader build needs no Wine and no Windows SDK anywhere (MiVic's
    solution, ported). The tool comes from the repository's tool manifest, which dotnet
    finds by walking up from the project directory. The compiled .mgfx lands next to its
    source and is NOT committed: a build regenerates it when the .fx changes.
  -->
  <Target Name="CompileEffects"
      BeforeTargets="RunContentBuilder"
      Inputs="Content\Sun.fx"
      Outputs="Content\Sun.mgfx">
    <Exec Command="dotnet tool restore" WorkingDirectory="$(MSBuildProjectDirectory)" IgnoreExitCode="false" />
    <Exec EnvironmentVariables="DOTNET_ROLL_FORWARD=Major"
        Command="dotnet tool run ShadowDuskCLI -- Content/Sun.fx Content/Sun.mgfx /Profile:OpenGL"
        WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
  <!--
    The version shown in the app is the repository's own name for the build, from
    git describe over the tags: exactly the tag on a tagged commit (v0.0.1 -> 0.0.1),
    tag-plus-distance past it (0.0.1-5-g5be8afa), and a dirty marker on a dirty tree.
    A release build therefore names itself without any workflow input, and a
    development build always says which commit it actually is. Stamped into
    InformationalVersion; BuildInfo reads it back.
  -->
  <Target Name="StampGitVersion" BeforeTargets="GetAssemblyAttributes">
    <Exec Command="git describe --tags --always --dirty" ConsoleToMsBuild="true" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitDescribe" />
    </Exec>
    <PropertyGroup Condition="'$(GitDescribe)' != ''">
      <InformationalVersion>$(GitDescribe.TrimStart('v'))</InformationalVersion>
    </PropertyGroup>
  </Target>

</Project>
